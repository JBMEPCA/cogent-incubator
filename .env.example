# ---- fleet-wide ----
# Pooled endpoint - the app opens and drops connections constantly.
DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require"
# Direct (unpooled) endpoint - prisma migrate takes a session advisory lock,
# and a pooler hands each statement to a different backend, so the lock is
# taken and lost between statements. Same string with "-pooler" removed.
DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"
AUTH_SECRET=""
CRON_SECRET=""
APP_URL="http://localhost:3000"

# Per-title credentials are encrypted in SiteCredential under this key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=""

ANTHROPIC_API_KEY=""
PEXELS_API_KEY=""
MILLIONVERIFIER_API_KEY=""
MAILCHIMP_API_KEY=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# NOTE: WP_URL, WP_USERNAME, WP_APP_PASSWORD, GSC_SITE_URL, GA4_PROPERTY_ID,
# MAILCHIMP_AUDIENCE_ID, NEWSLETTER_FROM_EMAIL and the OUTREACH_* set are NO
# LONGER environment variables. They are per-title and live encrypted in
# SiteCredential — set them in the app under a title's Settings, or seed them
# with scripts/seed-smart-sme.js.
