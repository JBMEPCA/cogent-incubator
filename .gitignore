# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

.vercel
.env*

# google service account key
service-account.json

# batch publisher run state
scripts/.batch-state.json
scripts/.enrich-state.json
scripts/held-*.html

# ...but the template with no values in it is how the required variables get
# documented for Vercel. .env* above would otherwise swallow it too.
!.env.example

.vercel
.env*

# Batch publisher runtime state, per title. Churns while a batch runs and
# has no business in version control.
scripts/.batch-state*.json
scripts/held-*.html

# Subscriber prospect data — personal data for tens of thousands of real
# people (emails, direct dials, employers). The ranked lists and the
# MillionVerifier reports are derived from the Apollo exports and are just as
# sensitive. They live on disk and in NewsletterProspect, never in git.
assets/mailchimpdata/ranked-*.csv
assets/mailchimpdata/mv-report-*.csv
