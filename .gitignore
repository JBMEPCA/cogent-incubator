# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

.vercel
.env*

# google service account key
service-account.json

# batch publisher run state
scripts/.batch-state.json
scripts/.enrich-state.json
scripts/held-*.html

# ...but the template with no values in it is how the required variables get
# documented for Vercel. .env* above would otherwise swallow it too.
!.env.example

.vercel
.env*

# Batch publisher runtime state, per title. Churns while a batch runs and
# has no business in version control.
scripts/.batch-state*.json
scripts/held-*.html

# Subscriber prospect data — personal data for tens of thousands of real
# people (emails, direct dials, employers). The ranked lists and the
# MillionVerifier reports are derived from the Apollo exports and are just as
# sensitive. They live on disk and in NewsletterProspect, never in git.
assets/mailchimpdata/ranked-*.csv
assets/mailchimpdata/mv-report-*.csv

# Rendered newsletter proofs — real subscriber-facing content, regenerated
# on demand by scripts/newsletter-proof.mjs. No reason to version them.
assets/newsletter-proofs/

# The Apollo exports and everything derived from them, matched on filename
# wherever they sit rather than on the directory they were last seen in.
#
# The rules above were written against assets/mailchimpdata/. On 1 Sep 2026 the
# same files turned up in "assets/New folder/", outside every one of them and
# staged for the next `git add -A`: 5,097 and 9,315 rows of real people with
# work emails and direct dial numbers. A path-scoped rule protects a path, not
# the data, and the data is what moves.
ranked-*.csv
mv-report-*.csv
**/Fleet Data.csv
**/Golf Data.csv
**/Airport Data.csv
